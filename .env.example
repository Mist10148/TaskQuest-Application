# ═══════════════════════════════════════════════════════════════════════════════
#  TaskQuest — shared environment for the bot, the web server and the web build
#
#  Copy to `.env` in the repository root (it is git-ignored) and fill it in:
#      cp .env.example .env
#
#  Every app reads this file. Optional per-app overrides can go in
#  apps/bot/.env or apps/server/.env, and real environment variables (Render,
#  CI, your shell) always take precedence over both files.
#  Full reference: docs/DEPLOYMENT.md#3-environment-variables
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ── Discord application (https://discord.com/developers/applications) ────────
# The bot and web login use the same application.
DISCORD_TOKEN=your_bot_token                 # Bot tab → Reset Token
CLIENT_ID=your_application_id                # General Information → Application ID
DISCORD_CLIENT_ID=your_application_id        # same value as CLIENT_ID
DISCORD_CLIENT_SECRET=your_client_secret     # OAuth2 → Client Secret
# Register slash commands to this server for instant updates (optional)
GUILD_ID=

# ── Web server ───────────────────────────────────────────────────────────────
# Origin users open in the browser. Local dev = the Vite dev server, which
# proxies /api to the web server. Add <PUBLIC_URL>/api/auth/callback as an
# OAuth2 redirect in the Discord portal.
PUBLIC_URL=http://localhost:8080
# Older name, read only when PUBLIC_URL is unset (prefer PUBLIC_URL)
# FRONTEND_URL=
# At least 32 characters; required in production. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=
# Extra origins allowed to make write requests (comma separated, optional)
# ALLOWED_ORIGINS=
# Override the OAuth redirect (defaults to <PUBLIC_URL>/api/auth/callback)
# DISCORD_REDIRECT_URI=
# Proxies in front of the server (default 1 in production, 0 otherwise)
# TRUST_PROXY=1
# Serve apps/web/dist from the web server (default true in production)
# SERVE_FRONTEND=true

# ── Ports ────────────────────────────────────────────────────────────────────
# Separate names so both apps can share this file. Don't set PORT here:
# hosting platforms set PORT per service.
SERVER_PORT=3001
BOT_PORT=3000

# ── Bot ──────────────────────────────────────────────────────────────────────
# Link shown by /app
WEB_APP_URL=http://localhost:8080

# ── Database (shared by the bot and the web server) ──────────────────────────
# PostgreSQL 15+ with the vector (pgvector) and citext extensions. Either a connection URL
# (Supabase: Connect -> Session pooler, port 5432; see docs/MIGRATION_POSTGRES.md)...
# DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ...or individual settings (a local PostgreSQL shown):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# (the Docker database from `npm run db:up` uses DB_PASSWORD=taskquest-dev)
DB_PASSWORD=
DB_NAME=taskquest
DB_POOL_SIZE=10                             # shared: the AI service reads this too, so set DB_POOL_SIZE=5 there if you want its smaller default
# TLS for cloud databases (Supabase: DB_SSL=true) — keep certificate verification on in production
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n..."
# Run migrations automatically when an app starts (default true)
# MIGRATE_ON_START=true

# ── Web build (optional; only VITE_* variables ever reach the browser) ───────
# Only for split deployments where the API is on another origin
# VITE_API_URL=https://api.example.com
# Where the Vite dev server proxies /api (default http://localhost:3001)
# VITE_DEV_API_TARGET=http://localhost:3001
# Shows an "Add Bot to Server" button in Settings (must be an https:// Discord invite URL):
# VITE_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=...&scope=bot+applications.commands

# ── Web push (optional; see docs/DEPLOYMENT.md) ─────────────────────────────
# Browser notifications for reminders. Off unless all three VAPID values are set (one or two is a startup error).
# Generate keys once with: npx web-push generate-vapid-keys
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=                     # server-side only, never VITE_*
# WEB_PUSH_SUBJECT=mailto:you@example.com   # or an https:// URL
# Push endpoints must be on a known push service (Google FCM, Mozilla, Windows, Apple). Extra host suffixes, comma separated:
# WEB_PUSH_ALLOWED_HOSTS=push.example.com
# Bot side: where to ask the web server to send a push (off when unset)
# WEB_PUSH_INTERNAL_URL=http://localhost:3001
# WEB_PUSH_INTERNAL_TOKEN=                  # >= 32 chars, same on web and bot; defaults to AI_INTERNAL_TOKEN
# WEB_PUSH_TIMEOUT_MS=5000

# Game rules (both apps)
# XP_WEEKLY_MODIFIER=on                   # set to off to disable the weekly modifier (it doubles one bonus source a week)

# ── AI (optional; see docs/AI_INTEGRATION.md) ────────────────────────────────
# Web service and Discord bot side (/summary, /prioritize, /ask, @mention chat)
AI_ENABLED=false
# AI_SERVICE_URL=http://localhost:8000      # web/bot -> ai
# AI_INTERNAL_TOKEN=                        # >= 32 chars, same value on web, bot and ai
# AI_TIMEOUT_MS=20000
# AI_STREAM_IDLE_MS=90000                   # cut a chat stream that is silent this long
# AI_CHAT_MESSAGE_CONTENT=false             # bot: true also answers replies with the ping off;
#                                           #      needs the Message Content intent in the Developer Portal

# AI service side (apps/ai reads this same file)
# WEB_INTERNAL_URL=http://localhost:3001    # ai -> web (/internal/*)
# GEMINI_API_KEY=                           # server-side only, never VITE_*
# GEMINI_CHAT_MODEL=gemini-2.5-flash        # confirm against Google's current model list
# GEMINI_REASONING_MODEL=gemini-2.5-pro
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# AI_DAILY_REQUEST_LIMIT=100                # per user per day (the user's own midnight), all features
# AI_DB_USER=                               # optional separate database user for the AI service
# AI_DB_PASSWORD=
# LANGSMITH_API_KEY=                        # optional tracing
# AI_RECONCILE_MINUTES=15                  # how often missed re-index calls are caught up
# EMBED_DEBOUNCE_SECONDS=3                  # edits to one list within this window share one re-embedding (0 = at once)
# SUMMARY_MAP_REDUCE_CHARS=40000            # summarize in parts above this input size
# MAX_TOOL_ITERATIONS=6                     # tool rounds per chat turn
# DB_POOL_SIZE=5                            # AI service database pool
# LOG_LEVEL=INFO                            # AI service JSON logs

# ── Tests (optional; these two are read from your shell or CI only, not from this file) ──
# Port the Playwright suite starts the API on (apps/web/e2e/env.mjs; the E2E_DB_* settings are in CONTRIBUTING.md)
# E2E_PORT=3101
# A scratch PostgreSQL migrated with `npm run db:migrate` for `pytest tests/postgres` in apps/ai (skipped when unset)
# AI_TEST_DB_URL=postgresql://postgres:pw@127.0.0.1:5432/taskquest_ai_test
