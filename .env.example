# ═══════════════════════════════════════════════════════════════════════════════
#  TaskQuest — shared environment for the bot, the web server and the web build
#
#  Copy to `.env` in the repository root (it is git-ignored) and fill it in:
#      cp .env.example .env
#
#  Every app reads this file. Optional per-app overrides can go in
#  apps/bot/.env or apps/server/.env, and real environment variables (Render,
#  CI, your shell) always take precedence over both files.
#  Full reference: docs/DEPLOYMENT.md#3-environment-variables
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=development

# ── Discord application (https://discord.com/developers/applications) ────────
# The bot and web login use the same application.
DISCORD_TOKEN=your_bot_token                 # Bot tab → Reset Token
CLIENT_ID=your_application_id                # General Information → Application ID
DISCORD_CLIENT_ID=your_application_id        # same value as CLIENT_ID
DISCORD_CLIENT_SECRET=your_client_secret     # OAuth2 → Client Secret
# Register slash commands to this server for instant updates (optional)
GUILD_ID=

# ── Web server ───────────────────────────────────────────────────────────────
# Origin users open in the browser. Local dev = the Vite dev server, which
# proxies /api to the web server. Add <PUBLIC_URL>/api/auth/callback as an
# OAuth2 redirect in the Discord portal.
PUBLIC_URL=http://localhost:8080
# At least 32 characters; required in production. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=
# Extra origins allowed to make write requests (comma separated, optional)
# ALLOWED_ORIGINS=
# Override the OAuth redirect (defaults to <PUBLIC_URL>/api/auth/callback)
# DISCORD_REDIRECT_URI=
# Proxies in front of the server (default 1 in production, 0 otherwise)
# TRUST_PROXY=1
# Serve apps/web/dist from the web server (default true in production)
# SERVE_FRONTEND=true

# ── Ports ────────────────────────────────────────────────────────────────────
# Separate names so both apps can share this file. Don't set PORT here:
# hosting platforms set PORT per service.
SERVER_PORT=3001
BOT_PORT=3000

# ── Bot ──────────────────────────────────────────────────────────────────────
# Link shown by /app
WEB_APP_URL=http://localhost:8080

# ── Database (shared by the bot and the web server) ──────────────────────────
# Either a connection URL...
# DB_URL=mysql://user:password@host:3306/taskquest
# ...or individual settings (local XAMPP/MySQL defaults shown):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskquest
DB_POOL_SIZE=10
# TLS for cloud databases — keep certificate verification on in production
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n..."
# Run migrations automatically when an app starts (default true)
# MIGRATE_ON_START=true

# ── Web build (optional; only VITE_* variables ever reach the browser) ───────
# Only for split deployments where the API is on another origin
# VITE_API_URL=https://api.example.com
# Where the Vite dev server proxies /api (default http://localhost:3001)
# VITE_DEV_API_TARGET=http://localhost:3001

# ── AI (optional; see docs/AI_INTEGRATION.md) ────────────────────────────────
AI_ENABLED=false
# AI_SERVICE_URL=http://localhost:8000      # web -> ai
# AI_INTERNAL_TOKEN=                        # >= 32 chars, same value on web and ai
# AI_TIMEOUT_MS=20000
