# TaskQuest Discord bot — copy to apps/bot/.env (never commit .env files).

# ── Discord (https://discord.com/developers/applications) ─────────────────────
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
# Optional: register commands to one guild for instant updates while developing
GUILD_ID=

# ── Database (shared with the web app) ────────────────────────────────────────
# Either a connection URL...
# DB_URL=mysql://user:password@host:3306/taskquest
# ...or individual settings (local XAMPP/MySQL defaults shown):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskquest
DB_POOL_SIZE=10
# TLS for cloud databases. Keep REJECT_UNAUTHORIZED=true in production.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n..."

# Run migrations automatically on startup (default true)
# MIGRATE_ON_START=true

# ── Misc ──────────────────────────────────────────────────────────────────────
# Port for the health endpoint (Render/Railway set this automatically)
PORT=3000
# Link used by /app
WEB_APP_URL=http://localhost:8080
