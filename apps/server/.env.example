# TaskQuest web server — copy to apps/server/.env (never commit .env files).

NODE_ENV=development
PORT=3001

# Origin users open in the browser. In development this is the Vite dev
# server (which proxies /api here); in production, this server's own URL.
PUBLIC_URL=http://localhost:8080
# Extra origins allowed to make state-changing requests (comma separated)
# ALLOWED_ORIGINS=

# REQUIRED in production, at least 32 characters:  openssl rand -base64 48
SESSION_SECRET=

# ── Discord OAuth2 (same application as the bot) ──────────────────────────────
# Add <PUBLIC_URL>/api/auth/callback as a redirect in the Discord portal.
DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_client_secret
# Optional override (defaults to <PUBLIC_URL>/api/auth/callback)
# DISCORD_REDIRECT_URI=

# ── Database (shared with the bot) ────────────────────────────────────────────
# DB_URL=mysql://user:password@host:3306/taskquest
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskquest
DB_POOL_SIZE=10
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n..."
# MIGRATE_ON_START=true

# Number of reverse proxies in front of this server (default 1 in production)
# TRUST_PROXY=1
# Serve apps/web/dist from this server (default: true in production)
# SERVE_FRONTEND=true
