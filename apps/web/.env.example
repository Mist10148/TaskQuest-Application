# Frontend build-time variables (all optional).
#
# The SPA calls the API with relative URLs (/api/...): in development the Vite
# dev server proxies /api to the Express server, and in production Express
# serves the built app itself, so frontend and API share one origin.

# Only set this for an unusual split deployment where the API lives on a
# different origin. Cross-site cookies will then be blocked by many browsers.
# VITE_API_URL=https://api.example.com

# Where the Vite dev proxy forwards /api (default http://localhost:3001).
# VITE_DEV_API_TARGET=http://localhost:3001
